# ============================================================
# 麒麟本地部署配置 (全部本地，无网环境)
# ============================================================
# cp env-local.template ../backend/.env
# SERVER_IP = 300I Duo 服务器 IP (默认 192.168.13.153)
# ============================================================

# ============ LLM (Qwen3-30B-A3B, chips 4-7, port 1028) ============
DASHSCOPE_API_KEY=not-needed
DASHSCOPE_BASE_URL=http://SERVER_IP:1028/v1
DASHSCOPE_BASE_URL_COMPLEX=http://SERVER_IP:1028/v1
DASHSCOPE_BASE_URL_SIMPLE=http://SERVER_IP:1028/v1
MODEL_TIER_COMPLEX=qwen3-30b-a3b
MODEL_TIER_SIMPLE=qwen3-30b-a3b
QWEN_TEXT_MODEL=qwen3-30b-a3b
DASHSCOPE_HTTP_API_URL=http://SERVER_IP:1028/v1

# ============ MinerU + NPU VLM (chips 0-1, port 1040) ============
# PDF 解析使用 MinerU pipeline, VLM 推理走 NPU 服务器
VL_SERVICE_BACKEND=mineru
MINERU_BACKEND=http-client
MINERU_VL_SERVER=http://SERVER_IP:1040/v1

# VLM 不用时不要回退到云端 (无网环境)
VL_SERVICE_FALLBACK_TO_QWEN=false

# MinerU 解析参数
MINERU_PARSE_METHOD=auto
MINERU_TABLE_ENABLE=true
MINERU_FORMULA_ENABLE=false
MINERU_LANG=ch
MINERU_OUTPUT_FORMAT=html
MINERU_TIMEOUT_SECONDS=600

# ============ 其他 ============
OPENAI_API_KEY=not-needed
OPENAI_API_BASE=http://SERVER_IP:1028/v1
DEEPSEEK_API_KEY=not-needed
DEEPSEEK_BASE_URL=http://SERVER_IP:1028/v1
DEEPSEEK_MODEL=qwen3-30b-a3b
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
HOST=0.0.0.0
PORT=8000
DEBUG=true
