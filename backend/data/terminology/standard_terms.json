        "category": "tools",
        "parameters": {
          "hardness": "HRA",
          "cutting_speed_limit": "m/min",
          "tool_life": "min"
        }
      },
      "陶瓷刀具": {
        "definition": "由陶瓷材料制成的切削刀具，适用于高速切削",
