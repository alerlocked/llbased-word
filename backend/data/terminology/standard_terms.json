        "category": "tools",
        "parameters": {
          "hardness": "HRA",
          "cutting_speed_limit": "m/min",
          "brittleness": "high"
        }
      },
      "立方氮化硼刀具": {
        "definition": "由立方氮化硼制成的超硬切削刀具，适用于淬硬钢加工",
        "alias": ["CBN_tool", "CBN刀具"],
        "category": "tools",
        "parameters": {
          "hardness": "HV",
          "cutting_speed_limit": "m/min",
          "application": "hardened_steel"
        }
      }
    },
    "materials": {
      "45号钢": {
