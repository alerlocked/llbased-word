{
  "enterprise_standard": {
    "machining": {
      "车削": {
        "definition": "使用车床对旋转工件进行切削加工的工艺方法",
        "alias": ["车床加工", "turning"],
        "category": "machining",
        "parameters": {
          "cutting_speed": "m/min",
          "feed_rate": "mm/rev",
          "depth_of_cut": "mm"
        }
      },
      "铣削": {
        "definition": "使用铣床对工件进行平面、曲面或沟槽加工的工艺方法",
        "alias": ["铣床加工", "milling"],
        "category": "machining",
        "parameters": {
          "spindle_speed": "rpm",
          "feed_rate": "mm/min",
          "depth_of_cut": "mm"
        }
      },
      "钻孔": {
        "definition": "使用钻头在工件上加工圆孔的工艺方法",
        "alias": ["钻削", "drilling"],
        "category": "machining",
        "parameters": {
          "spindle_speed": "rpm",
          "feed_rate": "mm/rev",
          "hole_diameter": "mm"
        }
      },
      "磨削": {
        "definition": "使用砂轮对工件表面进行精加工的工艺方法",
        "alias": ["研磨", "grinding"],
        "category": "machining",
        "parameters": {
          "wheel_speed": "m/s",
          "workpiece_speed": "m/min",
          "depth_of_cut": "mm"
        }
      },
      "镗孔": {
        "definition": "使用镗刀对已有孔进行扩大和精加工的工艺方法",
        "alias": ["boring"],
        "category": "machining",
        "parameters": {
          "spindle_speed": "rpm",
          "feed_rate": "mm/rev",
          "bore_diameter": "mm"
        }
      }
    },
    "assembly": {
      "螺栓连接": {
        "definition": "使用螺栓、螺母和垫圈将零件连接在一起的装配方法",
        "alias": ["bolted_joint", "螺栓紧固"],
        "category": "assembly",
        "parameters": {
          "torque": "N·m",
          "bolt_grade": "grade",
          "preload": "N"
        }
      },
      "焊接": {
        "definition": "通过加热或加压使金属材料连接在一起的工艺方法",
        "alias": ["welding", "熔接"],
        "category": "assembly",
        "parameters": {
          "current": "A",
          "voltage": "V",
          "welding_speed": "mm/min"
        }
      },
      "铆接": {
        "definition": "使用铆钉将零件连接在一起的机械连接方法",
        "alias": ["riveting"],
        "category": "assembly",
        "parameters": {
          "rivet_diameter": "mm",
          "rivet_length": "mm",
          "clamping_force": "N"
        }
      },
      "粘接": {
        "definition": "使用胶粘剂将材料连接在一起的工艺方法",
        "alias": ["bonding", "胶接"],
        "category": "assembly",
        "parameters": {
          "curing_time": "min",
          "curing_temperature": "°C",
          "bond_strength": "MPa"
        }
      }
    },
    "heat_treatment": {
      "淬火": {
        "definition": "将钢加热到临界温度以上，然后快速冷却以获得高硬度的热处理工艺",
        "alias": ["quenching", "水淬"],
        "category": "heat_treatment",
        "parameters": {
          "heating_temperature": "°C",
          "soaking_time": "min",
          "cooling_medium": "medium"
        }
      },
      "回火": {
        "definition": "将淬火后的钢重新加热到较低温度，然后冷却以降低脆性的热处理工艺",
        "alias": ["tempering"],
        "category": "heat_treatment",
        "parameters": {
          "tempering_temperature": "°C",
          "holding_time": "min",
          "cooling_method": "method"
        }
      },
      "退火": {
        "definition": "将金属加热到适当温度，保温后缓慢冷却以改善组织和性能的热处理工艺",
        "alias": ["annealing"],
        "category": "heat_treatment",
        "parameters": {
          "annealing_temperature": "°C",
          "holding_time": "min",
          "cooling_rate": "°C/h"
        }
      },
      "正火": {
        "definition": "将钢加热到临界温度以上，保温后在空气中冷却的热处理工艺",
        "alias": ["normalizing"],
        "category": "heat_treatment",
        "parameters": {
          "normalizing_temperature": "°C",
          "holding_time": "min",
          "cooling_in_air": true
        }
      }
    },
    "measurement": {
      "尺寸测量": {
        "definition": "使用量具对工件的几何尺寸进行测量的工艺方法",
        "alias": ["dimensional_measurement", "尺寸检测"],
        "category": "measurement",
        "parameters": {
          "measurement_accuracy": "mm",
          "measuring_instrument": "instrument",
          "environmental_conditions": "conditions"
        }
      },
      "形位公差测量": {
        "definition": "对工件的形状和位置公差进行测量的工艺方法",
        "alias": ["geometric_tolerance_measurement", "形位检测"],
        "category": "measurement",
        "parameters": {
          "tolerance_type": "type",
          "measurement_method": "method",
          "accuracy_class": "class"
        }
      },
      "表面粗糙度测量": {
        "definition": "对工件表面粗糙度进行测量的工艺方法",
        "alias": ["surface_roughness_measurement", "粗糙度检测"],
        "category": "measurement",
        "parameters": {
          "roughness_parameter": "parameter",
          "measurement_length": "mm",
          "cutoff_wavelength": "mm"
        }
      }
    },
    "tools": {
      "高速钢刀具": {
        "definition": "由高速钢制成的切削刀具，具有良好的红硬性和耐磨性",
