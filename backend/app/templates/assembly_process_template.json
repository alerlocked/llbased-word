      "output_key": "process_flow_steps"
    },
    {
      "phase": 2,
      "description": "Flow-dependent chapters — row count driven by process_flow_steps",
      "chapter_codes": ["G18a", "G22a", "G25a"],
      "depends_on": "process_flow_steps"
    },
    {
      "phase": 3,
      "description": "Independent chapters — no dependency on process flow",
      "chapter_codes": ["G4a", "G5a", "G10a", "G12a", "G14a"]
    }
  ],

