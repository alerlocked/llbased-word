  "entity_definitions": {
    "part_name": {
      "description": "零件名称或编号",
      "examples": ["零件A", "P-2024-001", "主轴箱", "齿轮"],
      "validation_pattern": "^[\\w\\d\\-\\s]+$"
    },
    "process_type": {
      "description": "工艺类型",
      "examples": ["加工", "装配", "焊接", "热处理", "检测"],
      "allowed_values": ["加工", "装配", "焊接", "热处理", "检测", "其他"]
    },
    "document_id": {
      "description": "工艺文件标识符",
      "examples": ["P-2024-001", "PROC-001", "工艺卡-2024-01"],
      "validation_pattern": "^[A-Za-z0-9\\-\\_]+$"
    },
    "edit_type": {
      "description": "编辑类型",
      "examples": ["修改", "添加", "删除", "更新"],
      "allowed_values": ["修改", "添加", "删除", "更新"]
    },
    "output_format": {
      "description": "输出文件格式",
      "examples": ["PDF", "Word", "Excel", "XML"],
      "allowed_values": ["PDF", "Word", "Excel", "XML", "JSON"]
    },
    "pdf_file": {
      "description": "PDF文件路径或内容",
      "examples": ["/path/to/file.pdf", "PDF数据流"],
      "validation": "file_exists_or_valid_data"
    },
    "search_query": {
      "description": "搜索查询语句",
      "examples": ["数控加工参数", "焊接工艺标准", "工具选用"],
      "validation": "non_empty_string"
    },
    "source_terms": {
      "description": "源术语列表",
      "examples": ["切削", "铣削", "钻孔"],
      "validation": "array_of_strings"
    },
    "compliance_type": {
      "description": "合规检查类型",
      "examples": ["安全", "质量", "环保", "行业"],
      "allowed_values": ["安全", "质量", "环保", "行业", "企业"]
    },
    "pdm_system": {
      "description": "PDM系统名称",
      "examples": ["Teamcenter", "Windchill", "SAP", "自定义系统"],
      "validation": "non_empty_string"
    }
  },
  "task_templates": {
    "pdf_parsing": {
      "name": "PDF文档解析",
      "description": "解析PDF格式的工艺文件，提取结构化信息",
      "parameters": {
        "extract_tables": true,
        "extract_text": true,
        "identify_structure": true,
        "accuracy_threshold": 0.97
      },
      "output_schema": {
        "tables": "array of extracted tables",
        "text": "extracted text content",
        "structure": "document structure information",
        "metadata": "file metadata"
      }
    },
    "rag_retrieval": {
      "name": "工艺知识检索",
      "description": "从知识库中检索相关工艺信息",
      "parameters": {
        "search_query": "用户查询",
        "top_k": 5,
        "rerank": true,
        "use_cache": true
      },
      "output_schema": {
        "documents": "retrieved documents",
        "scores": "relevance scores",
        "snippets": "relevant text snippets",
        "sources": "document sources"
      }
    },
    "terminology_alignment": {
      "name": "工艺术语对齐",
      "description": "将用户术语映射到标准工艺术语",
      "parameters": {
        "source_terms": "用户输入的术语",
        "target_standard": "企业工艺术语标准",
        "allow_suggestions": true
      },
      "output_schema": {
        "mappings": "术语映射关系",
        "confidence_scores": "映射置信度",
        "alternatives": "备选术语",
        "standard_definitions": "标准术语定义"
      }
    },
    "compliance_check": {
      "name": "合规性检查",
      "description": "检查工艺文件是否符合标准和规范",
      "parameters": {
        "check_level": "detailed",
        "include_standards": ["企业标准", "行业规范", "安全要求"],
        "generate_report": true
      },
      "output_schema": {
        "issues": "发现的问题",
        "suggestions": "改进建议",
        "compliance_score": "合规性评分",
        "report": "详细检查报告"
      }
    },
    "document_generation": {
      "name": "工艺文档生成",
      "description": "生成标准格式的工艺文件",
      "parameters": {
        "output_formats": ["pdf", "word"],
        "template": "standard_process_template",
        "include_metadata": true
      },
      "output_schema": {
        "generated_files": "生成的文件列表",
        "metadata": "文件元数据",
        "preview_url": "预览链接",
        "download_urls": "下载链接"
      }
    }
  },
