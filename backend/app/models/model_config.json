{
  "deepseek_r1": {
    "name": "DeepSeek-R1",
    "description": "DeepSeek-R1 14B/32B本地推理模型，用于工艺文件辅助编辑",
    "version": "1.0.0",
    "enabled": true,
    "model_sizes": ["14b", "32b"],
    "default_size": "14b",
    "model_path": "./models/deepseek-r1",
    "device": "cuda:0",
    "use_gpu": true,
    "max_tokens": 2048,
    "temperature": 0.7,
    "top_p": 0.95,
    "max_input_length": 10000,
    "supported_languages": ["zh", "en"],
    "memory_requirements": {
      "14b": "24GB",
      "32b": "64GB"
    },
    "performance_settings": {
      "batch_size": 1,
      "max_concurrent_requests": 2,
      "timeout_seconds": 300
    },
    "error_handling": {
      "retry_on_failure": true,
      "max_retries": 3,
      "fallback_to_smaller_model": true
    }
  },
  "bge_embedding": {
    "name": "BGE-Embedding",
    "description": "BGE-Embedding本地向量模型，用于工艺术语和知识的向量化",
    "version": "1.0.0",
    "enabled": true,
    "model_path": "./models/bge-large-zh-v1.5",
    "device": "cuda:0",
    "use_gpu": true,
    "embedding_dimension": 1024,
    "max_sequence_length": 512,
    "batch_size": 32,
    "normalize_embeddings": true
  },
  "bge_rerank": {
    "name": "BGE-Rerank",
    "description": "BGE-Rerank本地重排序模型，用于检索结果的精排序",
    "version": "1.0.0",
    "enabled": true,
    "model_path": "./models/bge-reranker-large",
    "device": "cuda:0",
    "use_gpu": true,
    "max_sequence_length": 512,
    "batch_size": 16
  }
}